        "information technology (IT) solutions engineer"@en,
        "infrastructure architect - information technology (IT)"@en,
        "microprocessor designer and application engineer"@en,
        "microwave systems engineer"@en,
        "microwave transmission systems engineer"@en,
        "network architect - computer systems"@en,
        "network capacity planner"@en,
        "network designer - computer systems"@en,
        "network engineer - communication hardware"@en,
        "network infrastructure engineer"@en,
        "network specialist - computer systems"@en,
        "network support engineer"@en,
