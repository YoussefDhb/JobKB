jobkb:UOCC_f37b961d0d4b a skos:Concept,
        jobkbo:Occupation ;
    skos:altLabel "battery data analyst"@en,
        "battery materials data analyst"@en,
        "battery module performance data analyst"@en,
        "business data analyst"@en,
        "data analist"@en,
        "data storage analyst"@en,
        "data warehouse analyst"@en,
        "data warehousing analyst"@en,
        "mine electrification data analyst"@en,
        "Data analyst"@fr,
        "analyste data"@fr,
        "analystes de données"@fr,
        "data analyst"@fr ;
    skos:broader jobkb:OCC_f7d6c0b45919 ;
    skos:definition "Data analysts import, inspect, clean, transform, validate, model, or interpret collections of data with regard to the business goals of the company. They ensure that the data sources and repositories provide consistent and reliable data. Data analysts use different algorithms and IT tools as demanded by the situation and the current data. They might prepare reports in the form of visualisations such as graphs, charts, and dashboards."@en ;
    skos:exactMatch wd:Q77293133 ;
    skos:inScheme jobkb:scheme ;
    skos:prefLabel "data analyst"@en,
        "analyste de données"@fr ;
