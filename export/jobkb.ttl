jobkb:UOCC_9fe2ef7bf755 a skos:Concept,
        jobkbo:Occupation ;
    skos:altLabel "ICT sysadmin"@en,
        "ICT sysadmins"@en,
        "IT system administrator"@en,
        "IT systems administrator"@en,
        "enterprise administrator"@en,
        "network administrator"@en,
        "server administrator"@en,
        "sysadmin"@en,
        "system and network administrator"@en,
        "system and networks administrator"@en,
        "administrateur de systèmes TIC"@fr,
        "administrateur de systèmes des technologies de l'information et de la communication"@fr,
        "administrateur de systèmes informatiques"@fr,
        "administrateur système"@fr,
        "administrateur systèmes"@fr,
        "administratrice de systèmes informatiques"@fr,
        "administratrice système"@fr,
        "administratrice systèmes"@fr ;
    skos:broader jobkb:OCC_b53bbd7b9fd5 ;
    skos:definition "ICT system administrators are responsible for the upkeep, configuration, and reliable operation of computer and network systems, servers, workstations and peripheral devices. They may acquire, install, or upgrade computer components and software; automate routine tasks; write computer programs; troubleshoot; train and supervise staff; and provide technical support. They ensure optimum system integrity, security, backup and performance."@en ;
    skos:inScheme jobkb:scheme ;
    skos:prefLabel "ICT system administrator"@en,
        "administrateur de systèmes informatiques/administratrice de systèmes informatiques"@fr ;
