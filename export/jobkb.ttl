jobkb:UOCC_90d808d67d2f a skos:Concept,
        jobkbo:Occupation ;
    skos:broader jobkb:OCC_5bdaba98cc31 ;
    skos:definition "An information-technology role (sr software engineer); job postings for it commonly require authorization, software, testing, data stores, docker container, secure gateways, data systems, security architecture."@en ;
    skos:inScheme jobkb:scheme ;
    skos:prefLabel "sr software engineer"@en,
