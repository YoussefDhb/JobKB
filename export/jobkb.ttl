jobkb:UOCC_b6db83a859f2 a skos:Concept,
        jobkbo:Occupation ;
    skos:altLabel "application lifecycle manager"@en,
        "configuration manager"@en,
        "software change and configuration manager"@en,
        "gestionnaire de changement et de configuration de logiciel"@fr,
        "gestionnaire du cycle de vie des applications"@fr,
        "ingénieur développement"@fr,
