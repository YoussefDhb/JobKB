jobkb:UOCC_d219486886bc a skos:Concept,
        jobkbo:Occupation ;
    skos:altLabel "application specific integrated circuit (ASIC) design engineer"@en,
        "capacity planning analyst"@en,
        "computer engineer"@en,
        "computer engineer (except software)"@en,
