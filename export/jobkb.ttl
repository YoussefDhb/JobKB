jobkb:UOCC_d97db129b36d a skos:Concept,
        jobkbo:Occupation ;
    skos:altLabel "Information Security Engineers"@en,
        "Architecte de sécurité des systèmes d'information"@fr,
        "Chargé / Chargée de mise en exploitation informatique"@fr,
        "Chef / Cheffe d'exploitation informatique"@fr,
        "Gestionnaire de production informatique"@fr,
        "Gestionnaire de ressources informatiques"@fr,
        "Ingénieur / Ingénieure d'exploitation informatique"@fr,
        "Ingénieur / Ingénieure de production informatique"@fr,
        "Ingénieur / Ingénieure systèmes, réseaux et sécurité"@fr,
        "Pilote de ressources informatiques"@fr,
        "Pilote multiserveur informatique"@fr ;
    skos:broader jobkb:OCC_5bdaba98cc31 ;
    skos:definition "Develop and oversee the implementation of information security procedures and policies. Build, maintain and upgrade security technology, such as firewalls, for the safe use of computer networks and the transmission and retrieval of information. Design and implement appropriate security controls to identify vulnerabilities and protect digital files and electronic infrastructures. Monitor and respond to computer security breaches, viruses, and intrusions, and perform forensic investigation. May oversee the assessment of information security systems."@en ;
    skos:inScheme jobkb:scheme ;
    skos:prefLabel "Computer Systems Engineers/Architects"@en,
        "Ingénieur / Ingénieure systèmes, réseaux et sécurité informatique"@fr ;
