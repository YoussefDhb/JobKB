jobkb:UOCC_a67d3cf28e2b a skos:Concept,
        jobkbo:Occupation ;
    skos:altLabel "ICT security chief"@en,
        "ICT security manager"@en,
        "ICT technical security expert"@en,
        "IT security chief"@en,
        "IT security manager"@en,
        "cyber risk manager"@en,
        "cybersecurity impact analyst"@en,
        "cybersecurity risk assessor"@en,
        "cybersecurity risk assurance consultant"@en,
        "cybersecurity specialist"@en,
        "information security manager"@en,
        "information security risk analyst"@en,
        "security coordinator"@en,
        "responsable de la sécurité TIC"@fr,
        "responsable de la sécurité de la technologie de l'information et de la communication"@fr,
