jobkb:UOCC_d54f5e85dea4 a skos:Concept,
        jobkbo:Occupation ;
    skos:altLabel "ICT environment manager"@en,
        "ICT environment managers"@en,
        "IT environmental manager"@en,
        "information and communication technologies environmental manager"@en,
        "information technologies environmental manager"@en,
        "directeur de l'environnement TIC"@fr,
        "directeur de l'environnement des technologies de l'information et de la communication"@fr,
        "directrice de l'environnement TIC"@fr,
        "directrice de l'environnement des technologies de l'information et de la communication"@fr,
        "responsable de l'environnement TIC"@fr,
        "responsable de l'environnement des technologies de l'information et de la communication"@fr ;
    skos:broader jobkb:OCC_e16915d06dfc ;
    skos:definition "ICT environmental managers know the green ICT legal framework, understand the role of the ICT network configurations in the economy and energy resources deployment and evaluate the impact of CO2 footprint of each ICT resource in the organisation's network. They plan and manage the implementation of environmental strategies for ICT networks and systems by conducting applied research, developing organisational policy, and devising strategies to meet sustainability targets. They ensure that the whole organisation uses ICT resources in a way that is as friendly as possible for the environment."@en ;
    skos:inScheme jobkb:scheme ;
    skos:prefLabel "ICT environmental manager"@en,
        "responsable de l'environnement informatique"@fr ;
