jobkb:UOCC_9f4469f34da0 a skos:Concept,
        jobkbo:Occupation ;
    skos:altLabel "ICT help desk managers"@en,
        "ICT helpdesk manager"@en,
        "ICT helpdesk managers"@en,
        "ICT service desk manager"@en,
        "IT help desk manager"@en,
        "IT helpdesk manager"@en,
        "software support manager"@en,
        "technical support manager"@en,
        "responsable du service d'aide aux utilisateurs"@fr,
        "responsable du service d'assistance en TIC"@fr,
        "responsable du service d'assistance en technologies de l'information et de la communication"@fr,
        "responsable help desk informatique"@fr ;
    skos:broader jobkb:OCC_77edcdb23a49 ;
    skos:definition "ICT help desk managers monitor the delivery of technical support services to clients according to the predefined deadlines. They plan and organise the user support actions and troubleshoot ICT problems and issues. ICT help desk managers supervise the help desk team ensuring that the customers get the appropriate feedback and support. They also participate in developing customer service guidelines and in reinforcing the team."@en ;
    skos:inScheme jobkb:scheme ;
    skos:prefLabel "ICT help desk manager"@en,
        "responsable du service d’assistance informatique"@fr ;
