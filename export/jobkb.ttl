        jobkbo:Occupation ;
    skos:altLabel "ICT documentation managers"@en,
        "IT documentation manager"@en,
        "documentation manager"@en,
        "technical communication manager"@en,
        "responsable de la documentation TIC"@fr,
        "responsable de la documentation sur les technologies de l'information et de la communication"@fr,
