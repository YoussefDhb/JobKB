jobkb:UOCC_75b70a6ee4c6 a skos:Concept,
        jobkbo:Occupation ;
    skos:altLabel "usability analyst"@en,
        "user experience analysts"@en,
        "user experience officer"@en,
        "analyste d'expérience d'utilisateur"@fr,
        "analyste d'utilisabilité"@fr,
        "analyste de l'expérience des utilisateurs"@fr,
        "analyste expérience utilisateur"@fr ;
    skos:broader jobkb:OCC_f7d6c0b45919 ;
    skos:definition "User experience analysts assess client interaction and experience and analyse users' behaviours, attitudes, and emotions about the usage of a particular product, system or service. They make proposals for the improvement of the interface and usability of products, systems or services. In doing so, they take into consideration the practical, experiential, affective, meaningful and valuable aspects of human–computer interaction and product ownership, as well as the person's perceptions of system aspects such as utility, ease of use and efficiency, and user experience dynamics."@en ;
    skos:inScheme jobkb:scheme ;
    skos:prefLabel "user experience analyst"@en,
        "analyste d’expérience utilisateur"@fr ;
