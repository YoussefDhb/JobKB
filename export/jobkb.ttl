        jobkbo:Occupation ;
    skos:altLabel "business analyst - computer systems"@en,
        "business continuity analyst"@en,
        "business data analyst"@en,
        "business intelligence analyst - information technology (IT)"@en,
        "business intelligence specialist"@en,
        "business process analyst"@en,
