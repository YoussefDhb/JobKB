jobkb:UOCC_0ab56111792f a skos:Concept,
        jobkbo:Occupation ;
    skos:broader jobkb:OCC_b53bbd7b9fd5 ;
    skos:definition "Plan, implement, upgrade, or monitor security measures for the protection of computer networks and information. Assess system vulnerabilities for security risks and propose and implement risk mitigation strategies. May ensure appropriate security controls are in place that will safeguard digital files and vital electronic infrastructure. May respond to computer security breaches and viruses."@en ;
    skos:inScheme jobkb:scheme ;
    skos:prefLabel "Information Security Analysts"@en,
        "Analyseurs de la sécurité de l'information"@fr ;
