jobkb:UOCC_ad6543a07628 a skos:Concept,
        jobkbo:Occupation ;
    skos:altLabel "application tester"@en,
        "application testing technician"@en,
        "quality assurance analyst - information systems"@en,
        "quality assurance tester - information systems"@en,
        "software test coordinator"@en,
        "software tester"@en,
        "software testing technician"@en,
        "systems tester"@en,
        "systems testing technician"@en,
        "test coordination analyst"@en,
        "user acceptance tester"@en,
        "video game tester"@en ;
    skos:broader jobkb:OCC_f7d6c0b45919 ;
    skos:definition "Information systems testing technicians execute test plans to evaluate the performance of software applications and information and telecommunications systems. They are employed in information technology units throughout the private and public sectors. Main duties: This group performs some or all of the following duties: Develop and document software testing plans Install software and hardware and configure operating system software in preparation for testing Execute, analyze and document results of software application, video game and information and telecommunication systems tests Develop and implement software and information system testing policies, procedures and scripts Identify, report, track and propose solutions to product defects."@en ;
    skos:inScheme jobkb:scheme ;
    skos:prefLabel "Information systems testing technicians"@en,
        "Évaluateurs/évaluatrices de systèmes informatiques"@fr ;
