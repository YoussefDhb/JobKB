jobkb:UOCC_c4f85bd2876c a skos:Concept,
        jobkbo:Occupation ;
    skos:altLabel "ICT auditor"@en,
        "IT Quality Appraiser"@en,
        "information technology auditor"@en,
        "auditeur des systèmes d'information"@fr,
        "auditeur informatique"@fr,
        "auditeur informatique/auditrice informatique"@fr,
        "auditrice des systèmes d'information"@fr,
        "auditrice informatique"@fr ;
    skos:broader jobkb:OCC_f7d6c0b45919 ;
    skos:definition "IT auditors perform audits of information systems, platforms, and operating procedures in accordance with established corporate standards for efficiency, accuracy and security. They evaluate ICT infrastructure in terms of risk to the organisation and establish controls to mitigate loss. They determine and recommend improvements in the current risk management controls and in the implementation of system changes or upgrades."@en ;
    skos:inScheme jobkb:scheme ;
    skos:prefLabel "IT auditor"@en,
        "auditeur des systèmes d’information/auditrice des systèmes d’information"@fr ;
