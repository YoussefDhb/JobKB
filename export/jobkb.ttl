        jobkbo:Occupation ;
    skos:altLabel "ICT resilience analysts"@en,
        "IT disaster recovery analyst"@en,
        "IT resilience analyst"@en,
        "business continuity analyst"@en,
        "business continuity strategist"@en,
        "disaster recovery officer"@en,
