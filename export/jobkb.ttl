jobkb:UOCC_75923f4cce69 a skos:Concept,
        jobkbo:Occupation ;
    skos:altLabel "data integrity officer"@en,
        "data integrity specialist"@en,
        "data quality expert"@en,
        "data quality officer"@en,
        "data quality specialists"@en,
        "analyste de la qualité des données"@fr,
        "analyste qualitatif"@fr,
        "analyste qualité de données"@fr,
        "analystes qualité de données"@fr ;
    skos:broader jobkb:OCC_b1fcf8e1ad43 ;
    skos:definition "Data quality specialists review organisation's data for accuracy, recommend enhancements to record systems and data acquisition processes and assess referential and historical integrity of data. They also develop documents and maintain data quality goals and standards and oversee an organisation's data privacy policy and monitor compliance of data flows against data quality standards."@en ;
    skos:inScheme jobkb:scheme ;
    skos:prefLabel "data quality specialist"@en,
        "analyste qualité des données"@fr ;
