    </node>
    <node id="UOCC_d758661e6802">
      <data key="label">Document Management Specialists</data>
      <data key="label_fr">Spécialistes en gestion des documents</data>
      <data key="kind">occupation</data>
      <data key="isco_code">2522</data>
      <data key="sources">ONET</data>
