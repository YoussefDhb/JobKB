      <data key="label_fr">hacker éthique</data>
      <data key="kind">occupation</data>
      <data key="isco_code">2529</data>
      <data key="wikidata_qid">Q18922761</data>
      <data key="sources">ESCO</data>
      <data key="description">Ethical hackers perform security vulnerability assessments and penetration tests in accordance with industry-accepted methods and protocols. They analyse systems for potential vulnerabilities that may result from improper system configuration, hardware or software flaws, or operational weaknesses.</data>
    </node>
