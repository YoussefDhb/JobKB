      <data key="label">ICT auditor manager</data>
      <data key="label_fr">responsable de l’audit informatique</data>
      <data key="kind">occupation</data>
      <data key="isco_code">2519</data>
      <data key="sources">ESCO</data>
      <data key="description">ICT auditor managers monitor ICT auditors responsible for auditing information systems, platforms, and operating procedures in accordance with established corporate standards for efficiency, accuracy and security. They evaluate ICT infrastructure in terms of risk to the organisation and establish controls to mitigate loss. They determine and recommend improvements in the current risk management controls and in the implementation of system changes or upgrades.</data>
    </node>
    <node id="UOCC_c342c11ce256">
